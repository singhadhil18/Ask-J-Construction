# Apache hosting: keep the static site compressed and cache fingerprinted assets.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Only the production hostname is canonical; preserve paths and queries.
  RewriteCond %{HTTP_HOST} ^www\.askjconstruction\.co\.za$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://askjconstruction.co.za%{REQUEST_URI} [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ https://askjconstruction.co.za/ [R=301,L]
  RewriteRule ^(about|services|projects|customer-testimonials|contact|service-areas-faq|luxury-home-builds|home-renovations|frameless-showers)/?$ /$1.html [R=301,L]
  # Defence in depth if a source checkout is accidentally uploaded again.
  RewriteRule (^|/)(\.git|\.qa-tools|\.qa-firefox|audits|recovered-original|__pycache__)(/|$) - [F,L]
</IfModule>
<FilesMatch "(?i)(\.(py|cjs|mjs|md|zip|map)$|^\.(gitignore|env.*)$|^(recovery-manifest|verification)\.json$)">
  Require all denied
</FilesMatch>
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^[a-f0-9]{20}([.-][a-z0-9]+)?\.(avif|webp|png|jpg|jpeg|woff|woff2|ttf|svg|bin)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
